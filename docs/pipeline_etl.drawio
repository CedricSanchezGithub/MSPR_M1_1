        <mxCell id="p4-process" value="&lt;b&gt;modele_predictif.py&lt;/b&gt;&#xa;scikit-learn · pandas · numpy&#xa;matplotlib · seaborn · geopandas" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1270" y="100" width="290" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p4-step1" value="&lt;b&gt;1. Feature engineering&lt;/b&gt; — construire_panel()&#xa;Panel temporel commune × année (2008/14/20)&#xa;12 features : population · 4 CSP · revenu_median&#xa;pct_diplome_sup · pct_sans_diplome · dette_par_hab&#xa;invest_par_hab · taux_natalite · nb_catnat" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1270" y="200" width="290" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p4-step2" value="&lt;b&gt;2. Préparation&lt;/b&gt;&#xa;StandardScaler.fit_transform(X_train)&#xa;Split temporel : train = 2008+2014 / test = 2020" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1270" y="320" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4-step3" value="&lt;b&gt;3. Entraînement — 2 Random Forest (n=200, seed=42)&lt;/b&gt;&#xa;• Classifier (camp Gauche/Droite)&#xa;  → accuracy · F1 · matrice confusion&#xa;• Regressor (% Gauche continu)&#xa;  → R² · MAE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1270" y="410" width="290" height="110" as="geometry" />
        </mxCell>
        <mxCell id="p4-step4" value="&lt;b&gt;4. Extrapolation 2026&lt;/b&gt; — extrapoler_features()&#xa;Population : tendance linéaire 2014→2020 prolongée&#xa;Autres variables : valeurs 2020 maintenues&#xa;CatNat : cumul historique inchangé" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1270" y="540" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p4-step5" value="&lt;b&gt;5. Prédictions 2026&lt;/b&gt; — predire_futur()&#xa;clf.predict() → pred_camp&#xa;reg.predict().clip(0,100) → pred_pct_gauche" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1270" y="650" width="290" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p4-graphs" value="&lt;b&gt;7 graphiques + console Q&amp;amp;R&lt;/b&gt;&#xa;01 importance features · 02 confusion · 03 temporel&#xa;04 carte 2026 · 05 distribution probabilités&#xa;06 réel vs prédit · 07 communes remarquables&#xa;Sortie : graphiques/phase4/*.png&#xa;Console : réponses Q1 / Q2 / Q3 (consignes)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B85450;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1270" y="740" width="290" height="120" as="geometry" />
