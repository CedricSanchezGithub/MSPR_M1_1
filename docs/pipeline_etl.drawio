        <mxCell id="p3-process" value="&lt;b&gt;analyse_exploratoire.py&lt;/b&gt;&#xa;Lecture SQLite via pd.read_sql_query&#xa;matplotlib · seaborn · numpy&#xa;geopandas + urllib (GeoJSON)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=11;" vertex="1" parent="1">
